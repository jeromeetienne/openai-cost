{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "composite": false,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "examples",
        "node_modules",
        "dist"
    ]
}