{
	"name": "openai-cost",
	"version": "1.0.6",
	"description": "OpenAI token usage cost calculator and fetch-based call tracker utilities.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeromeetienne/openai-cost.git"
	},
	"bugs": {
		"url": "https://github.com/jeromeetienne/openai-cost/issues"
	},
	"homepage": "https://github.com/jeromeetienne/openai-cost#readme",
	"scripts": {
		"sample:comparator": "tsx examples/openai_cost_comparator.ts",
		"sample:basic": "tsx examples/openai_cost_example.ts",
		"sample:tracker": "tsx examples/openai_cost_tracker_example.ts",
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
		"prepack": "npm run clean && npm run build",
		"publish:all": "npm run build && npm version patch && git add . && git commit -m 'version bump' && npm publish --access public",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [
		"openai",
		"cost",
		"token-usage",
		"tracker"
	],
	"author": "",
	"license": "MIT",
	"type": "commonjs",
	"sideEffects": false,
	"devDependencies": {
		"@keyv/sqlite": "^4.0.8",
		"@types/node": "^25.4.0",
		"chalk": "^5.6.2",
		"openai-cache": "^1.0.14",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"openai": "^6.27.0"
	}
}
