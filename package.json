	},
	"keywords": [
		"openai",
		"cost",
		"token-usage",
		"tracker"
	],
	"author": "",
	"license": "MIT",
	"type": "commonjs",
	"devDependencies": {
		"@keyv/sqlite": "^4.0.8",
		"@types/node": "^25.4.0",
		"chalk": "^5.6.2",
		"openai-cache": "^1.0.14"
	},
	"dependencies": {
		"openai": "^6.27.0",
		"typescript": "^5.9.3"
	}
}
