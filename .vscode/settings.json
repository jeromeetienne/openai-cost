{
    // format on save
    "editor.formatOnSave": true,
    // disable auto-detection of indentation to ensure consistent formatting
    "editor.detectIndentation": false,
    // indent with tabs and set tab size to 8
    "[typescript]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 8
    },
    "[typescriptreact]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 8
    },
    "[JSON]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 8
    },
    // Disable auto focus on debug views
    "debug.openDebug": "neverOpen",
    "debug.focusWindowOnBreak": false,
    // Prevent opening the source file on break
    "debug.openExplorerOnEnd": false,
    "debug.internalConsoleOptions": "neverOpen",
    // Critical: Disable “reveal on break”
    "debug.revealBreakpoint": false,
}